CREATE TABLE beatmapEntry (
    id INTEGER NOT NULL PRIMARY KEY,
    setId INTEGER NOT NULL,
    checksum TEXT NOT NULL,
    artist TEXT NOT NULL,
    artistUnicode TEXT NOT NULL,
    title TEXT NOT NULL,
    titleUnicode TEXT NOT NULL,
    mapper TEXT NOT NULL,
    version TEXT NOT NULL,
    source TEXT NOT NULL,
    tags TEXT NOT NULL,
    status TEXT NOT NULL,

    starsTotal REAL NOT NULL,
    starsAim REAL NOT NULL,
    starsSpeed REAL NOT NULL,
    ar REAL NOT NULL,
    cs REAL NOT NULL,
    od REAL NOT NULL,
    hp REAL NOT NULL,
    bpm REAL NOT NULL,
    circles INTEGER NOT NULL,
    sliders INTEGER NOT NULL,
    spinners INTEGER NOT NULL,
    maxCombo INTEGER NOT NULL,
    mp3Length INTEGER NOT NULL,

    firstSeenAt INTEGER NOT NULL,
    lastSeenAt INTEGER NOT NULL
);

CREATE INDEX beatmapEntry_setId ON beatmapEntry(setId);
CREATE INDEX beatmapEntry_checksum ON beatmapEntry(checksum);

insertOrReplaceBeatmap:
INSERT OR REPLACE INTO beatmapEntry (
    id, setId, checksum, artist, artistUnicode, title, titleUnicode, mapper, version,
    source, tags, status, starsTotal, starsAim, starsSpeed, ar, cs, od, hp, bpm,
    circles, sliders, spinners, maxCombo, mp3Length, firstSeenAt, lastSeenAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getBeatmapById:
SELECT * FROM beatmapEntry
WHERE id = :id;

getBeatmapByChecksum:
SELECT *
FROM beatmapEntry
WHERE checksum = ?
LIMIT 1;


touchLastSeen:
UPDATE beatmapEntry
SET lastSeenAt = :lastSeenAt
WHERE id = :id;

getAllBeatmaps:
SELECT * FROM beatmapEntry
ORDER BY lastSeenAt DESC;

countBeatmaps:
SELECT COUNT(*) FROM beatmapEntry;
CREATE TABLE profileSnapshotEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    pp REAL NOT NULL,
    level REAL NOT NULL,
    globalRank INTEGER NOT NULL,
    countryCode TEXT NOT NULL,
    accuracy REAL NOT NULL,
    playCount INTEGER NOT NULL,
    rankedScore INTEGER NOT NULL,
    matchmakingRating REAL NOT NULL,
    matchmakingRank INTEGER NOT NULL,
    matchmakingPlays INTEGER NOT NULL,
    matchmakingWins INTEGER NOT NULL,
    matchmakingIsProvisional INTEGER NOT NULL
);

CREATE INDEX profileSnapshotEntry_timestamp ON profileSnapshotEntry(timestamp);

insertProfileSnapshot:
INSERT INTO profileSnapshotEntry (
    timestamp, pp, level, globalRank, countryCode, accuracy, playCount, rankedScore,
    matchmakingRating, matchmakingRank, matchmakingPlays, matchmakingWins, matchmakingIsProvisional
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getSnapshotsBetween:
SELECT * FROM profileSnapshotEntry
WHERE timestamp >= :from AND timestamp <= :to
ORDER BY timestamp ASC;

getLatestSnapshot:
SELECT * FROM profileSnapshotEntry
ORDER BY timestamp DESC
LIMIT 1;

getAllSnapshots:
SELECT * FROM profileSnapshotEntry
ORDER BY timestamp ASC;

deleteSnapshotsBefore:
DELETE FROM profileSnapshotEntry
WHERE timestamp < :before;